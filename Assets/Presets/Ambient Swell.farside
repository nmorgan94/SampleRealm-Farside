<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Ambient Swell" category="Vast" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.92"/>
    <PARAM id="damping" value="0.45"/>
    <PARAM id="width" value="1.0"/>
    <PARAM id="mix" value="0.5"/>
    <PARAM id="highpassFreq" value="250.0"/>
    <PARAM id="lowpassFreq" value="6000.0"/>
    <PARAM id="drive" value="0.0"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="5.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.55"/>
    <PARAM id="delayLevel" value="0.5"/>
    <PARAM id="duck" value="0.4"/>
    <PARAM id="outputGain" value="0.0"/>
    <PARAM id="reverbType" value="2.0"/>
    <PARAM id="preDelay" value="30.0"/>
  </Parameters>
</PRESET>
