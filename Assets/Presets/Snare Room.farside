<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Snare Room" category="Drums" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.35"/>
    <PARAM id="damping" value="0.7"/>
    <PARAM id="width" value="0.7"/>
    <PARAM id="mix" value="0.12"/>
    <PARAM id="highpassFreq" value="200.0"/>
    <PARAM id="lowpassFreq" value="7000.0"/>
    <PARAM id="drive" value="0.0"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="4.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.35"/>
    <PARAM id="delayLevel" value="0.0"/>
    <PARAM id="duck" value="0.0"/>
    <PARAM id="outputGain" value="0.0"/>
  </Parameters>
</PRESET>
