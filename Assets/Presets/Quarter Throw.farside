<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Quarter Throw" category="Echo" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.7"/>
    <PARAM id="damping" value="0.5"/>
    <PARAM id="width" value="1.0"/>
    <PARAM id="mix" value="0.21"/>
    <PARAM id="highpassFreq" value="400.0"/>
    <PARAM id="lowpassFreq" value="20000.0"/>
    <PARAM id="drive" value="0.2"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="4.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.45"/>
    <PARAM id="delayLevel" value="0.6"/>
    <PARAM id="duck" value="0.6"/>
    <PARAM id="outputGain" value="0.0"/>
    <PARAM id="reverbType" value="1.0"/>
    <PARAM id="preDelay" value="20.0"/>
  </Parameters>
</PRESET>
