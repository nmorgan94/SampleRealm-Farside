<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Slap" category="Vocal" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.3"/>
    <PARAM id="damping" value="0.7"/>
    <PARAM id="width" value="0.6"/>
    <PARAM id="mix" value="0.17"/>
    <PARAM id="highpassFreq" value="250.0"/>
    <PARAM id="lowpassFreq" value="5000.0"/>
    <PARAM id="drive" value="0.0"/>
    <PARAM id="delaySync" value="0.0"/>
    <PARAM id="delayNote" value="4.0"/>
    <PARAM id="delayTime" value="110.0"/>
    <PARAM id="delayFeedback" value="0.1"/>
    <PARAM id="delayLevel" value="0.7"/>
    <PARAM id="duck" value="0.2"/>
    <PARAM id="outputGain" value="0.0"/>
  </Parameters>
</PRESET>
