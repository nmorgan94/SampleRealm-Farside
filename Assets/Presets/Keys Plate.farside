<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Keys Plate" category="Tight" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.55"/>
    <PARAM id="damping" value="0.5"/>
    <PARAM id="width" value="0.8"/>
    <PARAM id="mix" value="0.22"/>
    <PARAM id="highpassFreq" value="250.0"/>
    <PARAM id="lowpassFreq" value="20000.0"/>
    <PARAM id="drive" value="0.1"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="4.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.35"/>
    <PARAM id="delayLevel" value="0.0"/>
    <PARAM id="duck" value="0.3"/>
    <PARAM id="outputGain" value="0.0"/>
    <PARAM id="reverbType" value="1.0"/>
    <PARAM id="preDelay" value="15.0"/>
  </Parameters>
</PRESET>
