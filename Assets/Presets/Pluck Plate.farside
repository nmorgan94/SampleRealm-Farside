<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Pluck Plate" category="Echo" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.65"/>
    <PARAM id="damping" value="0.35"/>
    <PARAM id="width" value="1.0"/>
    <PARAM id="mix" value="0.3"/>
    <PARAM id="highpassFreq" value="400.0"/>
    <PARAM id="lowpassFreq" value="20000.0"/>
    <PARAM id="drive" value="0.0"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="3.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.5"/>
    <PARAM id="delayLevel" value="0.6"/>
    <PARAM id="duck" value="0.5"/>
    <PARAM id="outputGain" value="0.0"/>
    <PARAM id="reverbType" value="1.0"/>
    <PARAM id="preDelay" value="10.0"/>
  </Parameters>
</PRESET>
