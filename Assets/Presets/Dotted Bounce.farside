<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Dotted Bounce" category="Drums" author="SampleRealm" formatVersion="1">
  <Parameters>
    <PARAM id="roomSize" value="0.4"/>
    <PARAM id="damping" value="0.6"/>
    <PARAM id="width" value="0.8"/>
    <PARAM id="mix" value="0.3"/>
    <PARAM id="highpassFreq" value="500.0"/>
    <PARAM id="drive" value="0.0"/>
    <PARAM id="delaySync" value="1.0"/>
    <PARAM id="delayNote" value="3.0"/>
    <PARAM id="delayTime" value="375.0"/>
    <PARAM id="delayFeedback" value="0.5"/>
    <PARAM id="delayLevel" value="0.7"/>
    <PARAM id="duck" value="0.3"/>
    <PARAM id="outputGain" value="0.0"/>
  </Parameters>
</PRESET>
